# NOTE: keep comments on their own lines; inline comments after empty values
# can end up inside the value.

# Time Zone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=

# Cloudflare zone ID + scoped API token for Fail2Ban IP bans
# Token permission needed: Zone > Firewall Services > Edit (for this zone only)
CF_ZONE_ID=
CF_API_TOKEN=

# Vaultwarden
# Domain, not including https:// (e.g. vw.example.com)
DOMAIN=

# Set to false once you've created your account(s)
SIGNUPS_ALLOWED=true

# Who may create organizations: empty = everyone, "none", or comma-separated emails
ORG_CREATION_USERS=

# If you want to show password hint
SHOW_PASSWORD_HINT=false

# Admin page token. Generate an argon2 hash with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Keep the SINGLE quotes, otherwise docker compose mangles the `$` characters.
# Leave empty to disable the admin page entirely.
# /admin is additionally protected by Cloudflare Access (see README).
ADMIN_TOKEN=''

# Yubikey Settings
YUBICO_CLIENT_ID=
YUBICO_SECRET_KEY=
YUBICO_SERVER=

# Cloudflare Tunnel Token
CF_TUNNEL_TOKEN=

# Backups
BACKUP_ENABLED=true
# The backup location in the rclone docker
BACKUP_DIR="/backup"
# Vaultwarden data location in rclone docker
BACKUP_DATA_DIR="/data"
# rclone config volume mount path
BACKUP_RCLONE_CONFIG="/config/rclone.conf"
# rclone remote name; use the encrypted `crypt` remote (see rclone/rclone.conf.template).
# Leave empty for local-only backups.
BACKUP_RCLONE_REMOTE_NAME="gdrive-crypt"
# Path inside the remote
BACKUP_RCLONE_REMOTE_PATH="backups"
# Must be one of ["15min", "hourly", "daily", "weekly", "monthly"]
BACKUP_FREQUENCY="daily"
# Backups older than this many days are deleted locally and on the remote
BACKUP_RETENTION_DAYS=30
# Optional: healthchecks.io (or compatible) ping URL, alerts you if backups stop/fail
BACKUP_HEALTHCHECK_URL=
