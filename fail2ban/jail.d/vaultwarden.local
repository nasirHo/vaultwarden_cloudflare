# path_f2b/jail.d/vaultwarden.local

[vaultwarden]
enabled = true
port = 80,443
filter = vaultwarden
action = cloudflare-zone-token
logpath = /logs/vaultwarden.log
maxretry = 5
bantime = 6h
findtime = 6h

[vaultwarden-admin]
enabled = true
port = 80,443
filter = vaultwarden-admin
action = cloudflare-zone-token
logpath = /logs/vaultwarden.log
maxretry = 3
bantime = 6h
findtime = 6h
