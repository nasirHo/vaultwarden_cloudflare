# Vaultwarden settings. Copy to vaultwarden.env (chmod 600) and edit.
#
# Only lines that are present (uncommented) are passed to Vaultwarden, so leave
# anything you don't use COMMENTED OUT rather than empty: some settings
# (e.g. YUBICO_SERVER, SMTP_HOST) fail validation on an empty value and
# Vaultwarden refuses to start.
#
# Any option from Vaultwarden's .env.template works here:
# https://github.com/dani-garcia/vaultwarden/blob/main/.env.template
#
# DOMAIN, LOG_FILE, IP_HEADER and TZ are set in docker-compose.yml / .env and
# take precedence over this file.
#
# Keep comments on their own lines, and keep values containing `$` in SINGLE
# quotes (docker compose would otherwise try to expand them).

## Admin page token (argon2 hash). Generate with:
##   docker run --rm -it vaultwarden/server:1.37.5-alpine /vaultwarden hash
## Leave commented out to disable the admin page entirely.
## /admin is additionally protected by Cloudflare Access (see README).
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'

## Set to true only while creating your account(s)
SIGNUPS_ALLOWED=false

## Show password hint on the login page
SHOW_PASSWORD_HINT=false

## Who may create organizations: unset = everyone, "none", or comma-separated emails
# ORG_CREATION_USERS=you@example.com

## Mobile push notifications (live sync on iOS/Android).
## Get an installation ID + key at https://bitwarden.com/host
## When migrating, reuse your existing ID/key.
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
## Only if you chose the "European Union" data region at bitwarden.com/host:
# PUSH_RELAY_URI=https://api.bitwarden.eu
# PUSH_IDENTITY_URI=https://identity.bitwarden.eu

## SMTP (invitations, email 2FA, new-device alerts), e.g. Gmail with an app password
# SMTP_HOST=smtp.gmail.com
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=Vaultwarden
# SMTP_SECURITY=starttls
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=

## Yubikey OTP (set CLIENT_ID and SECRET_KEY together; SERVER only for a custom server)
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
# YUBICO_SERVER=https://
